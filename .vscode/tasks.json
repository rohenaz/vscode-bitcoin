// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [{
		"type": "shell",
		"command": "bun",
		"args": ["run", "dev"],
		"problemMatcher": {
			"pattern": {
				"regexp": "^.*$"
			},
			"background": {
				"activeOnStart": true,
				"beginsPattern": "vite v.*building for production",
				"endsPattern": "built in .*ms"
			}
		},
		"isBackground": true,
		"presentation": {
			"reveal": "always",
			"panel": "new"
		},
		"group": {
			"kind": "build",
			"isDefault": true
		},
		"label": "bun: dev"
	}]
}