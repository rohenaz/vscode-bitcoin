{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2020"],
    "sourceMap": true,
    "rootDir": ".",
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedParameters": true,
    "baseUrl": ".",
    "paths": {
      "vscode": ["./setup"],
      "*": ["node_modules/*"]
    },
    "esModuleInterop": true
  },
  "include": ["src/**/*", "test/**/*", "setup.ts", "types/**/*"],
  "exclude": ["node_modules", ".vscode-test"]
}
