{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["esnext"],
    "sourceMap": true,
    "rootDir": ".",
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedParameters": true,
    "baseUrl": ".",
    "paths": {
      "vscode": ["./setup"]
    },
    "types": ["@types/vscode", "node", "bun-types"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "setup.ts"
  ],
  "exclude": [
    "node_modules",
    ".vscode-test"
  ]
}
