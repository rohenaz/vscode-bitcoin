# Keep only necessary images
images/**
!images/icon.png
!images/b_icon.svg

.vscode/**
.vscode-test/**
src/**
.gitignore
vsc-extension-quickstart.md
**/tsconfig.json
**/*.map
src/**/*.ts
dist/**/*.map
biome.json
vite.config.ts
bun.lockb
.cursorrules
bunfig.toml
assistant_snippet_*.txt

# Make sure dist folder is included
!dist/**/*.js
dist/**/*.map

# Development files
.github/**
.git/**
.DS_Store
*.vsix
*.log
*.tgz

# Include only required node_modules files
node_modules/**

# @bsv/sdk - only include dist and necessary files
!node_modules/@bsv/sdk/dist/**
!node_modules/@bsv/sdk/package.json
!node_modules/@bsv/sdk/LICENSE.txt

# node-fetch - only lib and necessary files
!node_modules/node-fetch/lib/**
!node_modules/node-fetch/package.json
!node_modules/node-fetch/LICENSE.md

# typed-html - only dist and necessary files
!node_modules/typed-html/dist/**
!node_modules/typed-html/package.json

# bmapjs - only dist and necessary files
!node_modules/bmapjs/dist/**
!node_modules/bmapjs/package.json
!node_modules/bmapjs/LICENSE

# bpu-ts - only dist and necessary files
!node_modules/bpu-ts/dist/**
!node_modules/bpu-ts/package.json
!node_modules/bpu-ts/LICENSE