{
  "name": "bitcoin",
  "displayName": "Bitcoin",
  "description": "Bitcoin utilities for VS Code",
  "publisher": "Satchmo",
  "version": "0.1.0",
  "icon": "images/icon.png",
  "type": "commonjs",
  "engines": {
    "vscode": "^1.93.0",
    "node": "^16.0.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rohenaz/vscode-bitcoin.git"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "bitcoin.convertData",
        "title": "Bitcoin: Convert Data Format (Hex/Base64/Binary)"
      },
      {
        "command": "bitcoin.test",
        "title": "Bitcoin: Test Command"
      },
      {
        "command": "bitcoin.asmFromScript",
        "title": "Bitcoin: ASM from Script"
      },
      {
        "command": "bitcoin.addressFromWIF",
        "title": "Bitcoin: Address from WIF"
      },
      {
        "command": "bitcoin.addressFromPublicKey",
        "title": "Bitcoin: Address from Public Key"
      },
      {
        "command": "bitcoin.addressFromPrivateKey",
        "title": "Bitcoin: Address From Private Key"
      },
      {
        "command": "bitcoin.addressFromHDPublicKey",
        "title": "Bitcoin: Address From Extended Public Key"
      },
      {
        "command": "bitcoin.addressFromHDPrivateKey",
        "title": "Bitcoin: Address From Extended Private Key"
      },
      {
        "command": "bitcoin.generatePublicKey",
        "title": "Bitcoin: Generate Public Key"
      },
      {
        "command": "bitcoin.generatePrivateKey",
        "title": "Bitcoin: Generate Private Key"
      },
      {
        "command": "bitcoin.generateHDPublicKey",
        "title": "Bitcoin: Generate Extended Public Key"
      },
      {
        "command": "bitcoin.getUtxosForAddress",
        "title": "Bitcoin: Get UTXOs for Address"
      },
      {
        "command": "bitcoin.xPubFromxPriv",
        "title": "Bitcoin: Extended Public Key from Extended Private Key"
      },
      {
        "command": "bitcoin.extendedPrivateKeyFromMnemonic",
        "title": "Bitcoin: Extended Private Key from Mnemonic"
      },
      {
        "command": "bitcoin.generateHDPrivateKey",
        "title": "Bitcoin: Generate ExtendedPrivate Key"
      },
      {
        "command": "bitcoin.generateMnemonic",
        "title": "Bitcoin: Generate Mnemonic"
      },
      {
        "command": "bitcoin.generateWIF",
        "title": "Bitcoin: Generate WIF"
      },
      {
        "command": "bitcoin.getTx",
        "title": "Bitcoin: Fetch a Tx by Transaction ID"
      },
      {
        "command": "bitcoin.publicKeyFromPrivateKey",
        "title": "Bitcoin: Public Key From Private Key"
      },
      {
        "command": "bitcoin.decodeRawTx",
        "title": "Bitcoin: Decode Raw Transaction"
      },
      {
        "command": "bitcoin.rawTxToBob",
        "title": "Bitcoin: Raw Tx to Bob"
      },
      {
        "command": "bitcoin.detectAndConvert",
        "title": "Bitcoin: Detect and Convert Content",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.showKeyVault",
        "title": "Bitcoin: Show Key Vault",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.encrypt",
        "title": "Bitcoin: Encrypt Data",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.decrypt",
        "title": "Bitcoin: Decrypt Data",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.lookupBapProfile",
        "title": "Bitcoin: Lookup BAP Profile",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.resetWelcomeScreen",
        "title": "Bitcoin: Reset Welcome Screen",
        "category": "Bitcoin"
      }
    ],
    "configuration": {
      "title": "Bitcoin",
      "properties": {
        "bitcoin.workspace.path": {
          "type": "string",
          "default": ".bitcoin",
          "description": "Path to the Bitcoin workspace directory (relative to workspace root)"
        },
        "bitcoin.workspace.detectContentType": {
          "type": "boolean",
          "default": true,
          "description": "Automatically detect content types when saving files"
        },
        "bitcoin.workspace.organizeFolders": {
          "type": "boolean",
          "default": true,
          "description": "Organize files into subfolders by type"
        },
        "bitcoin.outputPreference": {
          "type": "string",
          "enum": ["clipboard", "file", "workspace"],
          "default": "clipboard",
          "description": "Where to output results (clipboard, file dialog, or workspace)"
        },
        "bitcoin.bapIndexerUrl": {
          "type": "string",
          "default": "https://api.sigmaidentity.com",
          "description": "URL of the BAP identity indexer API"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run build",
    "build": "vite build",
    "build:test": "tsc -p ./",
    "dev": "vite build --watch",
    "lint": "biome lint .",
    "lint:fix": "biome check --apply .",
    "format": "biome format . --write",
    "check": "biome check --apply .",
    "test": "bun test src/test/suite/extension.test.ts",
    "package": "vsce package",
    "publish": "vsce publish",
    "clean": "rm -rf dist node_modules *.vsix out"
  },
  "devDependencies": {
    "@biomejs/biome": "1.5.3",
    "@types/glob": "^7.2.0",
    "@types/node": "^20.17.10",
    "@types/node-fetch": "^2.6.12",
    "@types/vscode": "^1.93.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "bun-types": "^1.1.41",
    "glob": "^7.2.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "extensionDependencies": [],
  "extensionKind": ["workspace"],
  "dependencies": {
    "@bsv/sdk": "^1.2.19",
    "node-fetch": "^2.7.0",
    "vscode": "^1.1.37"
  },
  "optionalDependencies": {
    "bmapjs": "^0.4.0-beta.61",
    "bpu-ts": "^0.0.26"
  }
}
