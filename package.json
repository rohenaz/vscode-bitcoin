{
  "name": "bitcoin",
  "displayName": "Bitcoin",
  "description": "Bitcoin utilities for VS Code",
  "publisher": "Satchmo",
  "version": "0.1.0",
  "icon": "images/icon.png",
  "type": "commonjs",
  "engines": {
    "vscode": "^1.93.0",
    "node": "^16.0.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rohenaz/vscode-bitcoin.git"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "bitcoin.convertData",
        "title": "Convert Data",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.test",
        "title": "Bitcoin: Test Command"
      },
      {
        "command": "bitcoin.asmFromScript",
        "title": "Bitcoin: ASM from Script"
      },
      {
        "command": "bitcoin.addressFromWIF",
        "title": "Bitcoin: Address from WIF"
      },
      {
        "command": "bitcoin.addressFromPublicKey",
        "title": "Bitcoin: Address from Public Key"
      },
      {
        "command": "bitcoin.addressFromPrivateKey",
        "title": "Bitcoin: Address From Private Key"
      },
      {
        "command": "bitcoin.addressFromHDPublicKey",
        "title": "Bitcoin: Address From Extended Public Key"
      },
      {
        "command": "bitcoin.addressFromHDPrivateKey",
        "title": "Bitcoin: Address From Extended Private Key"
      },
      {
        "command": "bitcoin.generatePublicKey",
        "title": "Bitcoin: Generate Public Key"
      },
      {
        "command": "bitcoin.generatePrivateKey",
        "title": "Bitcoin: Generate Private Key"
      },
      {
        "command": "bitcoin.generateHDPublicKey",
        "title": "Bitcoin: Generate Extended Public Key"
      },
      {
        "command": "bitcoin.getUtxosForAddress",
        "title": "Bitcoin: Get UTXOs for Address"
      },
      {
        "command": "bitcoin.xPubFromxPriv",
        "title": "Bitcoin: Extended Public Key from Extended Private Key"
      },
      {
        "command": "bitcoin.extendedPrivateKeyFromMnemonic",
        "title": "Bitcoin: Extended Private Key from Mnemonic"
      },
      {
        "command": "bitcoin.generateHDPrivateKey",
        "title": "Bitcoin: Generate ExtendedPrivate Key"
      },
      {
        "command": "bitcoin.generateMnemonic",
        "title": "Bitcoin: Generate Mnemonic"
      },
      {
        "command": "bitcoin.generateWIF",
        "title": "Bitcoin: Generate WIF"
      },
      {
        "command": "bitcoin.getTx",
        "title": "Bitcoin: Fetch Transaction",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.publicKeyFromPrivateKey",
        "title": "Bitcoin: Public Key From Private Key"
      },
      {
        "command": "bitcoin.publicKeyFromWIF",
        "title": "Bitcoin: Public Key From WIF"
      },
      {
        "command": "bitcoin.decodeRawTx",
        "title": "Bitcoin: Decode Raw Transaction"
      },
      {
        "command": "bitcoin.rawTxToBob",
        "title": "Bitcoin: Raw Tx to Bob"
      },
      {
        "command": "bitcoin.decodeFile",
        "title": "Bitcoin: Decode Base64 Content to File",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.showKeyVault",
        "title": "Bitcoin: Show Key Vault",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.encrypt",
        "title": "Bitcoin: Encrypt Data",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.decrypt",
        "title": "Bitcoin: Decrypt Data",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.lookupBapProfile",
        "title": "Bitcoin: Lookup BAP Profile",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.resetWelcomeScreen",
        "title": "Bitcoin: Reset Welcome Screen",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.openConversionTool",
        "title": "Open Conversion Tool",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.debugSelection",
        "title": "Debug Selection",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.convertToHex",
        "title": "Bitcoin: Convert to Hex",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.convertToBase64",
        "title": "Bitcoin: Convert to Base64",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.convertToBinary",
        "title": "Bitcoin: Convert to Binary",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.decodeHex",
        "title": "Bitcoin: Decode Hex",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.decodeBase64",
        "title": "Bitcoin: Decode Base64",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.exploreAddress",
        "title": "Bitcoin: Explore Address on WhatsOnChain",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.fetchOrdinalsInscription",
        "title": "Fetch Ordinals Inscription",
        "category": "Bitcoin"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorHasSelection",
          "command": "bitcoin.debugSelection",
          "group": "bitcoin@0"
        },
        {
          "when": "editorHasSelection && selection =~ /^[1][a-km-zA-HJ-NP-Z1-9]{25,34}$/",
          "command": "bitcoin.getUtxosForAddress",
          "group": "bitcoin@1"
        },
        {
          "when": "editorHasSelection && selection =~ /^[1][a-km-zA-HJ-NP-Z1-9]{25,34}$/",
          "command": "bitcoin.exploreAddress",
          "group": "bitcoin@1"
        },
        {
          "when": "editorHasSelection && selection =~ /^[1][a-km-zA-HJ-NP-Z1-9]{25,34}$/",
          "command": "bitcoin.convertToHex",
          "group": "bitcoin@1"
        },
        {
          "when": "editorHasSelection && selection =~ /^[0-9a-fA-F]{64}$/",
          "command": "bitcoin.getTx",
          "group": "bitcoin@2"
        },
        {
          "when": "editorHasSelection && selection =~ /^[0-9a-fA-F]{64}_[0-9]+$/",
          "command": "bitcoin.fetchOrdinalsInscription",
          "group": "bitcoin@2"
        },
        {
          "when": "editorHasSelection && !(selection =~ /^[1][a-km-zA-HJ-NP-Z1-9]{25,34}$/) && !(selection =~ /^[0-9a-fA-F]+$/)",
          "command": "bitcoin.convertToHex",
          "group": "bitcoin.convert@1"
        },
        {
          "when": "editorHasSelection && !(selection =~ /^[A-Za-z0-9+/=]+$/)",
          "command": "bitcoin.convertToBase64",
          "group": "bitcoin.convert@2"
        },
        {
          "when": "editorHasSelection && !(selection =~ /^[01]+$/)",
          "command": "bitcoin.convertToBinary",
          "group": "bitcoin.convert@3"
        },
        {
          "when": "editorHasSelection && selection =~ /^[0-9a-fA-F]+$/",
          "command": "bitcoin.decodeHex",
          "group": "bitcoin.decode@1"
        },
        {
          "when": "editorHasSelection && selection =~ /^[A-Za-z0-9+/=]+$/",
          "command": "bitcoin.decodeBase64",
          "group": "bitcoin.decode@2"
        },
        {
          "when": "editorHasSelection",
          "command": "bitcoin.encrypt",
          "group": "bitcoin.encrypt@1"
        },
        {
          "when": "editorHasSelection",
          "command": "bitcoin.decrypt",
          "group": "bitcoin.encrypt@2"
        }
      ],
      "bitcoin.contextMenu": [
        {
          "when": "editorHasSelection && editorTextFocus && selection =~ /^[1][a-km-zA-HJ-NP-Z1-9]{25,34}$/",
          "command": "bitcoin.getUtxosForAddress",
          "title": "Get UTXOs for Address",
          "group": "lookup@2"
        },
        {
          "when": "editorHasSelection && editorTextFocus && selection =~ /^[0-9a-fA-F]+$/",
          "command": "bitcoin.convertData",
          "title": "Convert from Hex",
          "group": "conversion@1"
        },
        {
          "when": "editorHasSelection && editorTextFocus && selection =~ /^[A-Za-z0-9+/=]+$/",
          "command": "bitcoin.convertData",
          "title": "Convert from Base64",
          "group": "conversion@2"
        },
        {
          "when": "editorHasSelection",
          "command": "bitcoin.encrypt",
          "title": "Encrypt Data",
          "group": "encryption@1"
        },
        {
          "when": "editorHasSelection",
          "command": "bitcoin.decrypt",
          "title": "Decrypt Data",
          "group": "encryption@2"
        },
        {
          "command": "bitcoin.openConversionTool",
          "title": "Open Conversion Tool",
          "group": "conversion@3"
        }
      ]
    },
    "submenus": [
      {
        "id": "bitcoin.contextMenu",
        "label": "Bitcoin",
        "icon": "$(symbol-key)"
      }
    ],
    "configuration": {
      "title": "Bitcoin",
      "properties": {
        "bitcoin.workspace.path": {
          "type": "string",
          "default": ".bitcoin",
          "description": "Path to the Bitcoin workspace directory (relative to workspace root)"
        },
        "bitcoin.workspace.detectContentType": {
          "type": "boolean",
          "default": true,
          "description": "Automatically detect content types when saving files"
        },
        "bitcoin.workspace.organizeFolders": {
          "type": "boolean",
          "default": true,
          "description": "Organize files into subfolders by type"
        },
        "bitcoin.outputPreference": {
          "type": "string",
          "enum": ["clipboard", "file", "workspace"],
          "default": "clipboard",
          "description": "Where to output results (clipboard, file dialog, or workspace)"
        },
        "bitcoin.bapIndexerUrl": {
          "type": "string",
          "default": "https://api.sigmaidentity.com",
          "description": "URL of the BAP identity indexer API"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bitcoin-tools",
          "title": "Bitcoin Tools",
          "icon": "media/bitcoin.svg"
        }
      ]
    },
    "views": {
      "bitcoin-tools": [
        {
          "type": "webview",
          "id": "bitcoin.conversionView",
          "name": "Data Conversion"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run build",
    "build": "VITE_CJS_IGNORE_WARNING=true vite build",
    "build:test": "tsc -p ./",
    "dev": "vite build --watch",
    "lint": "biome lint .",
    "lint:fix": "biome check --apply .",
    "format": "biome format . --write",
    "check": "biome check --apply .",
    "test": "bun test",
    "package": "vsce package",
    "publish": "vsce publish",
    "clean": "rm -rf dist node_modules *.vsix out"
  },
  "devDependencies": {
    "@biomejs/biome": "1.5.3",
    "@types/glob": "^7.2.0",
    "@types/is-base64": "^1.1.3",
    "@types/node": "^20.17.10",
    "@types/node-fetch": "^2.6.12",
    "@types/vscode": "^1.93.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "bun-types": "^1.1.41",
    "glob": "^7.2.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "extensionDependencies": [],
  "extensionKind": ["workspace"],
  "dependencies": {
    "@bsv/sdk": "^1.2.19",
    "is-base64": "^1.1.0",
    "is-hex": "^1.1.3",
    "js-1sat-ord": "^0.1.79",
    "node-fetch": "^2.7.0",
    "typed-html": "^3.0.1",
    "vscode": "^1.1.37"
  },
  "optionalDependencies": {
    "bmapjs": "^0.4.0-beta.61",
    "bpu-ts": "^0.0.26"
  }
}
