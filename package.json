{
  "name": "bitcoin",
  "displayName": "Bitcoin",
  "description": "Bitcoin utilities for VS Code",
  "publisher": "Satchmo",
  "version": "0.1.0",
  "icon": "images/icon.png",
  "type": "commonjs",
  "engines": {
    "vscode": "^1.93.1",
    "node": "^16.0.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:plaintext",
    "onLanguage:markdown",
    "onLanguage:json"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rohenaz/vscode-bitcoin.git"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "bitcoin.convertData",
        "title": "Convert Data",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.test",
        "title": "Test Command",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.asmFromScript",
        "title": "ASM from Script",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.addressFromWIF",
        "title": "Address from WIF",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.addressFromPublicKey",
        "title": "Address from Public Key",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.addressFromPrivateKey",
        "title": "Address From Private Key",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.addressFromHDPublicKey",
        "title": "Address From Extended Public Key",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.addressFromHDPrivateKey",
        "title": "Address From Extended Private Key",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.generatePublicKey",
        "title": "Generate Public Key",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.generatePrivateKey",
        "title": "Generate Private Key",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.generateHDPublicKey",
        "title": "Generate Extended Public Key",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.getUtxosForAddress",
        "title": "Get UTXOs for Address",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.xPubFromxPriv",
        "title": "Extended Public Key from Extended Private Key",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.extendedPrivateKeyFromMnemonic",
        "title": "Extended Private Key from Mnemonic",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.generateHDPrivateKey",
        "title": "Generate Extended Private Key",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.generateMnemonic",
        "title": "Generate Mnemonic",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.generateWIF",
        "title": "Generate WIF",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.getTx",
        "title": "Fetch Transaction",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.publicKeyFromPrivateKey",
        "title": "Public Key From Private Key",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.publicKeyFromWIF",
        "title": "Public Key From WIF",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.decodeRawTx",
        "title": "Decode Raw Transaction",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.rawTxToBob",
        "title": "Raw Tx to Bob",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.decodeFile",
        "title": "Decode Base64 Content to File",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.showKeyVault",
        "title": "Show Key Vault",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.encrypt",
        "title": "Encrypt Data",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.decrypt",
        "title": "Decrypt Data",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.lookupBapProfile",
        "title": "Lookup BAP Profile",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.resetWelcomeScreen",
        "title": "Reset Welcome Screen",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.openConversionTool",
        "title": "Open Conversion Tool",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.debugSelection",
        "title": "Debug Selection",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.exploreAddress",
        "title": "Explore Address on WhatsOnChain",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.fetchOrdinalsInscription",
        "title": "Fetch Ordinals Inscription",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.convertToHex",
        "title": "Convert to Hex",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.convertToBase64",
        "title": "Convert to Base64",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.convertToBinary",
        "title": "Convert to Binary",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.decodeHex",
        "title": "Decode Hex",
        "category": "Bitcoin"
      },
      {
        "command": "bitcoin.decodeBase64",
        "title": "Decode Base64",
        "category": "Bitcoin"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "bitcoin.convertToHex",
          "when": "false"
        },
        {
          "command": "bitcoin.convertToBase64",
          "when": "false"
        },
        {
          "command": "bitcoin.convertToBinary",
          "when": "false"
        },
        {
          "command": "bitcoin.decodeHex",
          "when": "false"
        },
        {
          "command": "bitcoin.decodeBase64",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "when": "editorHasSelection",
          "command": "bitcoin.debugSelection",
          "group": "bitcoin@0"
        },
        {
          "when": "editorHasSelection && selection =~ /^[1][a-km-zA-HJ-NP-Z1-9]{25,34}$/",
          "command": "bitcoin.getUtxosForAddress",
          "group": "bitcoin@1"
        },
        {
          "when": "editorHasSelection && selection =~ /^[1][a-km-zA-HJ-NP-Z1-9]{25,34}$/",
          "command": "bitcoin.exploreAddress",
          "group": "bitcoin@1"
        },
        {
          "when": "editorHasSelection && selection =~ /^[1][a-km-zA-HJ-NP-Z1-9]{25,34}$/",
          "command": "bitcoin.convertToHex",
          "group": "bitcoin@1"
        },
        {
          "when": "editorHasSelection && selection =~ /^[0-9a-fA-F]{64}$/",
          "command": "bitcoin.getTx",
          "group": "bitcoin@2"
        },
        {
          "when": "editorHasSelection && selection =~ /^[0-9a-fA-F]{64}_[0-9]+$/",
          "command": "bitcoin.fetchOrdinalsInscription",
          "group": "bitcoin@2"
        },
        {
          "when": "editorHasSelection && !(selection =~ /^[1][a-km-zA-HJ-NP-Z1-9]{25,34}$/) && !(selection =~ /^[0-9a-fA-F]+$/)",
          "command": "bitcoin.convertToHex",
          "group": "bitcoin.convert@1"
        },
        {
          "when": "editorHasSelection && !(selection =~ /^[A-Za-z0-9+/=]+$/)",
          "command": "bitcoin.convertToBase64",
          "group": "bitcoin.convert@2"
        },
        {
          "when": "editorHasSelection && !(selection =~ /^[01]+$/)",
          "command": "bitcoin.convertToBinary",
          "group": "bitcoin.convert@3"
        },
        {
          "when": "editorHasSelection && selection =~ /^[0-9a-fA-F]+$/",
          "command": "bitcoin.decodeHex",
          "group": "bitcoin.decode@1"
        },
        {
          "when": "editorHasSelection && selection =~ /^[A-Za-z0-9+/=]+$/",
          "command": "bitcoin.decodeBase64",
          "group": "bitcoin.decode@2"
        },
        {
          "when": "editorHasSelection",
          "command": "bitcoin.encrypt",
          "group": "bitcoin.encrypt@1"
        },
        {
          "when": "editorHasSelection",
          "command": "bitcoin.decrypt",
          "group": "bitcoin.encrypt@2"
        }
      ],
      "bitcoin.contextMenu": [
        {
          "when": "editorHasSelection && editorTextFocus && selection =~ /^[1][a-km-zA-HJ-NP-Z1-9]{25,34}$/",
          "command": "bitcoin.getUtxosForAddress",
          "title": "Get UTXOs for Address",
          "group": "lookup@2"
        },
        {
          "command": "bitcoin.openConversionTool",
          "title": "Open Conversion Tool",
          "group": "conversion@3"
        }
      ]
    },
    "submenus": [
      {
        "id": "bitcoin.contextMenu",
        "label": "Bitcoin",
        "icon": "$(symbol-key)"
      }
    ],
    "configuration": {
      "title": "Bitcoin",
      "properties": {
        "bitcoin.workspace.path": {
          "type": "string",
          "default": ".bitcoin",
          "description": "Path to the Bitcoin workspace directory (relative to workspace root)"
        },
        "bitcoin.workspace.detectContentType": {
          "type": "boolean",
          "default": true,
          "description": "Automatically detect content types when saving files"
        },
        "bitcoin.workspace.organizeFolders": {
          "type": "boolean",
          "default": true,
          "description": "Organize files into subfolders by type"
        },
        "bitcoin.outputPreference": {
          "type": "string",
          "enum": ["clipboard", "file", "workspace"],
          "default": "clipboard",
          "description": "Where to output results (clipboard, file dialog, or workspace)"
        },
        "bitcoin.bapIndexerUrl": {
          "type": "string",
          "default": "https://api.sigmaidentity.com",
          "description": "URL of the BAP identity indexer API"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bitcoin-tools",
          "title": "Bitcoin Tools",
          "icon": "images/b_icon.svg"
        }
      ]
    },
    "views": {
      "bitcoin-tools": [
        {
          "type": "webview",
          "id": "bitcoin.conversionView",
          "name": "Data Conversion"
        }
      ]
    },
    "grammars": [
      {
        "scopeName": "bitcoin.injection",
        "path": "./syntaxes/bitcoin-injection.tmLanguage.json",
        "injectTo": [
          "source.js",
          "source.jsx",
          "source.ts",
          "source.tsx",
          "source.mts",
          "source.cts",
          "source.python",
          "source.go",
          "source.rust",
          "source.java",
          "source.c",
          "source.cpp",
          "source.csharp",
          "source.ruby",
          "source.php",
          "source.swift",
          "text.html.markdown",
          "text.plain",
          "source.json",
          "source.yaml",
          "source.toml"
        ]
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "opcode",
        "superType": "keyword",
        "description": "Bitcoin opcodes"
      }
    ],
    "semanticTokenScopes": [
      {
        "scopes": {
          "opcode": ["keyword.other.opcode.bitcoin"]
        }
      }
    ]
  },
  "scripts": {
    "build": "VITE_CJS_IGNORE_WARNING=true vite build",
    "build:test": "tsc -p ./",
    "dev": "vite build --watch",
    "lint": "biome lint .",
    "lint:fix": "biome check --apply .",
    "format": "biome format . --write",
    "check": "biome check --apply .",
    "test": "bun test",
    "package": "vsce package",
    "package:pre": "vsce package --pre-release",
    "publish": "vsce publish",
    "publish:pre": "vsce publish --pre-release",
    "clean": "rm -rf dist node_modules *.vsix out"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/glob": "^8.1.0",
    "@types/node": "^22.10.7",
    "@types/node-fetch": "^2.6.12",
    "@types/vscode": "^1.93.1",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "bun-types": "^1.1.45",
    "glob": "^11.0.1",
    "source-map-explorer": "^2.5.3",
    "typescript": "^5.3.3",
    "vite": "^6.0.7",
    "vscode": "^1.1.37"
  },
  "extensionDependencies": [],
  "extensionKind": ["workspace"],
  "dependencies": {
    "@bsv/sdk": "^1.3.5",
    "node-fetch": "^3.3.2",
    "typed-html": "^3.0.1"
  },
  "optionalDependencies": {
    "bmapjs": "^0.4.0-beta.63",
    "bpu-ts": "^0.0.26"
  }
}
